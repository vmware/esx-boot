#
# esx-boot master Makefile
#

TOPDIR     := .
include env/common.mk

MAKEFLAGS  += -I ../env

SHAREDLIBS := bootlib       \
              libc          \
              libfat        \
              libcrc        \
              libmd5        \
              libuart       \
              mbedtls       \
              zlib

SUBDIRS    := $(SHAREDLIBS) \
              $(FIRMWARE)   \
              mboot         \
              safeboot

## Build the test programs only in obj (developer) builds
ifeq ($(OBJDIR),obj)
   SUBDIRS += tests
endif

# Building rules
.PHONY: all clean $(SUBDIRS)

all: $(SUBDIRS)

$(SUBDIRS): check_env
	@$(MAKE) -C $@

# Ability to build just menu
menu: check_env
	@$(MAKE) -C uefi menu

# Dependencies
mboot safeboot: $(SHAREDLIBS) $(FIRMWARE)
$(FIRMWARE): $(SHAREDLIBS)

# Cleaning rules
clean:
	$(call RMDIR,build)

check_env:
ifndef BUILDENV
	$(error BUILDENV must be defined)
endif
